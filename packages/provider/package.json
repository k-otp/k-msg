{
  "name": "@k-msg/provider",
  "version": "0.30.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "description": "Complete provider system with adapters and implementations for K-Message platform",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./aligo": {
      "types": "./dist/aligo/index.d.ts",
      "import": "./dist/aligo/index.mjs",
      "require": "./dist/aligo/index.cjs"
    },
    "./aligo/send": {
      "types": "./dist/aligo/send.d.ts",
      "import": "./dist/aligo/send.mjs",
      "require": "./dist/aligo/send.cjs"
    },
    "./aligo/template": {
      "types": "./dist/aligo/template.d.ts",
      "import": "./dist/aligo/template.mjs",
      "require": "./dist/aligo/template.cjs"
    },
    "./iwinv": {
      "types": "./dist/iwinv/index.d.ts",
      "import": "./dist/iwinv/index.mjs",
      "require": "./dist/iwinv/index.cjs"
    },
    "./iwinv/send": {
      "types": "./dist/iwinv/send.d.ts",
      "import": "./dist/iwinv/send.mjs",
      "require": "./dist/iwinv/send.cjs"
    },
    "./iwinv/template": {
      "types": "./dist/iwinv/template.d.ts",
      "import": "./dist/iwinv/template.mjs",
      "require": "./dist/iwinv/template.cjs"
    },
    "./solapi": {
      "types": "./dist/solapi/index.d.ts",
      "import": "./dist/solapi/index.mjs",
      "require": "./dist/solapi/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts ./src/aligo/index.ts ./src/aligo/send.ts ./src/aligo/template.ts ./src/iwinv/index.ts ./src/iwinv/send.ts ./src/iwinv/template.ts ./src/solapi/index.ts --outdir ./dist --format esm --minify --sourcemap --entry-naming '[dir]/[name].mjs' --external 'bun:test' --external 'solapi' --external '@k-msg/*'",
    "build:cjs": "bun build ./src/index.ts ./src/aligo/index.ts ./src/aligo/send.ts ./src/aligo/template.ts ./src/iwinv/index.ts ./src/iwinv/send.ts ./src/iwinv/template.ts ./src/solapi/index.ts --outdir ./dist --format cjs --minify --sourcemap --entry-naming '[dir]/[name].cjs' --external 'bun:test' --external 'solapi' --external '@k-msg/*'",
    "build:types": "tsc",
    "dev": "tsc --watch",
    "test": "bun run test:unit",
    "test:unit": "bun test",
    "test:integration": "bun test --timeout=10000 integration.test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "ttsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "pack": "bun pm pack",
    "publish": "bun publish --access public"
  },
  "dependencies": {
    "@k-msg/core": "workspace:*",
    "@k-msg/template": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "solapi": "^6.0.1",
    "ttsc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "solapi": "^5.5.4 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "solapi": {
      "optional": true
    }
  },
  "keywords": [
    "provider",
    "plugin",
    "architecture",
    "messaging",
    "k-message",
    "iwinv",
    "alimtalk",
    "adapter"
  ],
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-otp/k-msg.git"
  },
  "homepage": "https://github.com/k-otp/k-msg",
  "bugs": {
    "url": "https://github.com/k-otp/k-msg/issues"
  },
  "author": "imjlk",
  "license": "MIT"
}
