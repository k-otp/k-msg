PORT=3000

# Required. Every endpoint needs "Authorization: Bearer <API_TOKEN>".
# At least 32 characters; generate one with: openssl rand -hex 32
API_TOKEN=

# Sends the AlimTalk: mock (default, no credentials) | iwinv | solapi | aligo
KMSG_PROVIDER=mock
# Sends the SMS/LMS fallback; empty means the same as KMSG_PROVIDER
KMSG_SMS_PROVIDER=
# Sender number registered with your providers, digits only.
# Required unless both providers are mock.
KMSG_SENDER_NUMBER=

# Code of the approved AlimTalk template (text: SHIPPED_TEMPLATE in src/notifier.ts)
ALIMTALK_TEMPLATE_ID=ORDER_SHIPPED
# Kakao sender profile: the pfId for solapi, the sender key for aligo
KAKAO_PROFILE_ID=
# Kakao channel ID such as @myshop; required for solapi
KAKAO_PLUS_ID=

TRACKING_DB_PATH=./data/tracking.db

# iwinv: the AlimTalk key, plus the SMS keys and company id when it sends SMS
IWINV_API_KEY=
IWINV_SMS_API_KEY=
IWINV_SMS_AUTH_KEY=
IWINV_SMS_COMPANY_ID=

# solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# aligo (test mode validates requests without sending them)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_TEST_MODE=false
