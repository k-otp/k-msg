PORT=3000

# mock (default, no credentials) | iwinv | solapi | aligo
KMSG_PROVIDER=mock
# Sender number registered with your provider, digits only.
# Required unless KMSG_PROVIDER=mock.
KMSG_SENDER_NUMBER=

# Required. HMAC key for stored codes, at least 32 bytes.
# Generate one with: openssl rand -hex 32
OTP_SECRET=

# Codes the whole service may send per hour (default 1000).
OTP_MAX_SENDS_PER_HOUR=1000
# Behind a load balancer or reverse proxy, the number of proxies in front of
# the server (usually 1), so the per-client limit sees the real client address.
TRUST_PROXY=

# KMSG_PROVIDER=iwinv: the AlimTalk key plus the SMS key pair
IWINV_API_KEY=
IWINV_SMS_API_KEY=
IWINV_SMS_AUTH_KEY=

# KMSG_PROVIDER=solapi
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# KMSG_PROVIDER=aligo (test mode validates requests without sending them)
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_TEST_MODE=false
