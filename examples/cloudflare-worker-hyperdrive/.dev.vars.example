# Copy to .dev.vars for `wrangler dev` (git-ignored). Values here override
# "vars" in wrangler.jsonc. In production, use `wrangler secret put`.

# Required. Bearer token for every endpoint, at least 32 characters.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# The default provider is mock: nothing is sent, no keys are needed, and the
# cron reports every message as DELIVERED.
# To send for real, pick a provider, set its keys, and set the sender number
# registered with it (digits only).
# KMSG_PROVIDER=iwinv
# KMSG_SENDER_NUMBER=0212345678

# KMSG_PROVIDER=iwinv: the AlimTalk key, the SMS key pair, and the company id
# that SMS delivery status lookups need
# IWINV_API_KEY=
# IWINV_SMS_API_KEY=
# IWINV_SMS_AUTH_KEY=
# IWINV_SMS_COMPANY_ID=

# KMSG_PROVIDER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=

# KMSG_PROVIDER=aligo (test mode validates requests without sending them;
# Aligo has no delivery status lookup, so the cron cannot update its messages)
# ALIGO_API_KEY=
# ALIGO_USER_ID=
# ALIGO_TEST_MODE=false
