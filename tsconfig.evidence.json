{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "plugins": [
      { "transform": "@ttsc/lint", "configFile": "./lint.evidence.config.ts" }
    ]
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/dist/**",
    "**/node_modules/**"
  ]
}
